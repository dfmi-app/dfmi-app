# ---- dfmi buyer config ----

# Your buyer wallet's private key (REQUIRED). The wallet needs dUSD — claim from
# https://faucet.dfmi.app. It does NOT need native coin; the facilitator pays gas.
# Copy this file to ".env" and fill in your key. NEVER commit or share the .env file.
BUYER_PRIVATE_KEY=0xYourPrivateKey

# dfmi network endpoints (facilitator that settles payments, and the service catalog).
FACILITATOR_URL=https://facilitator.dfmi.app
DFMI_CATALOG_URL=https://facilitator.dfmi.app/catalog
